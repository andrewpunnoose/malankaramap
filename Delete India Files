.github/workflows/delete-india-files.yml
name: Delete India Files

on:
  workflow_dispatch:

jobs:
  delete-files:
    runs-on: ubuntu-latest

    permissions:
      contents: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Delete files starting with india
        run: |
          find . -type f -name 'india*' -not -path './.git/*' -delete

      - name: Commit and push changes
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A
          git diff --cached --quiet || git commit -m "Delete files starting with india"
          git push
